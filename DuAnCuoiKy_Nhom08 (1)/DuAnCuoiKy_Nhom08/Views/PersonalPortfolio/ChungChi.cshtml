
@{
    ViewBag.Title = "ChungChi";
    Layout = "~/Views/Shared/_LayoutTrangChu.cshtml";
}
<link href="~/Content/MyStyleSheet/StyleSheetPortfolio.css" rel="stylesheet" />
<section class="page-heading">
    <span class="eyebrow">CERTIFICATES</span>
    <h1>Chứng chỉ & thành tựu</h1>
    <p>Các chứng chỉ, giải thưởng và thành tích đã đạt được.</p>
</section>
<section class="certificate-grid">
    <article class="certificate-card">
        <div class="certificate-image">CERTIFICATE</div>
        <div class="certificate-body">
            <h3>Tên chứng chỉ</h3>
            <p>Đơn vị cấp: Tên tổ chức</p>
            <p>Ngày cấp: DD/MM/YYYY</p>
            <a href="#">Xem xác thực →</a>
        </div>
    </article>
    <article class="certificate-card">
        <div class="certificate-image">ACHIEVEMENT</div>
        <div class="certificate-body">
            <h3>Tên thành tựu</h3>
            <p>Đơn vị cấp: Tên tổ chức</p>
            <p>Ngày đạt: DD/MM/YYYY</p>
            <a href="#">Xem chi tiết →</a>
        </div>
    </article>
</section>

