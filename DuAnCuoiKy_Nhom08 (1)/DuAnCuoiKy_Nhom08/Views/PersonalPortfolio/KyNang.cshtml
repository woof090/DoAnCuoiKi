
@{
    ViewBag.Title = "KyNang";
    Layout = "~/Views/Shared/_LayoutTrangChu.cshtml";
}
<link href="~/Content/MyStyleSheet/StyleSheetPortfolio.css" rel="stylesheet" />

<section class="page-heading">
    <span class="eyebrow">MY ABILITIES</span>
    <h1>Kỹ năng</h1>
    <p>Các kỹ năng chuyên môn và kỹ năng mềm.</p>
</section>

<section class="section-block">
    <div class="skill-list">
        <!-- HTML -->
        <article class="skill-card">
            <div class="skill-top">
                <h3>HTML</h3>
                <b>85%</b>
            </div>
            <div class="progress">
                <span style="width:85%"></span>
            </div>
            <p>Thiết kế cấu trúc trang web.</p>
        </article>

        <!-- CSS -->
        <article class="skill-card">
            <div class="skill-top">
                <h3>CSS</h3>
                <b>80%</b>
            </div>
            <div class="progress">
                <span style="width:80%"></span>
            </div>
            <p>Trình bày giao diện và bố cục.</p>
        </article>

        <!-- JavaScript -->
        <article class="skill-card">
            <div class="skill-top">
                <h3>JavaScript</h3>
                <b>65%</b>
            </div>
            <div class="progress">
                <span style="width:65%"></span>
            </div>
            <p>Xử lý tương tác phía trình duyệt.</p>
        </article>

        <!-- C# (Kỹ năng mới bổ sung) -->
        <article class="skill-card">
            <div class="skill-top">
                <h3>C# / ASP.NET</h3>
                <b>75%</b>
            </div>
            <div class="progress">
                <span style="width:75%"></span>
            </div>
            <p>Phát triển logic và xử lý phía Server.</p>
        </article>

        <!-- SQL Server (Kỹ năng mới bổ sung) -->
        <article class="skill-card">
            <div class="skill-top">
                <h3>SQL Server</h3>
                <b>70%</b>
            </div>
            <div class="progress">
                <span style="width:70%"></span>
            </div>
            <p>Thiết kế và quản trị cơ sở dữ liệu.</p>
        </article>

        <!-- Teamwork (Kỹ năng mới bổ sung) -->
        <article class="skill-card">
            <div class="skill-top">
                <h3>Teamwork</h3>
                <b>90%</b>
            </div>
            <div class="progress">
                <span style="width:90%"></span>
            </div>
            <p>Phối hợp và làm việc nhóm hiệu quả.</p>
        </article>
    </div>
</section>


