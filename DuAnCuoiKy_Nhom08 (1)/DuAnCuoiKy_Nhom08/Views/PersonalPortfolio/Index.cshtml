@{
    ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_LayoutTrangChu.cshtml";
}
<link href="~/Content/MyStyleSheet/StyleSheetPortfolio.css" rel="stylesheet" />
<section class="hero-card">
    <div class="hero-text">
        <span class="eyebrow">XIN CHÀO, MÌNH LÀ</span>
        <h1>Họ và tên của bạn</h1>
        <h2>Personal Portfolio</h2>
        <p>Đây là phần giới thiệu ngắn về bản thân, chuyên ngành và định hướng nghề nghiệp của bạn.</p>
        <div class="hero-actions">
            <a class="button-primary" href="@Url.Action("LienHe", "PersonalPortfolio")">Liên hệ với tôi</a>
            <a class="button-outline" href="#">Tải CV</a>
        </div>
    </div>
    <div class="avatar-placeholder">ẢNH<br />ĐẠI DIỆN</div>
</section>
<section class="section-block">
    <div class="section-heading"><span class="eyebrow">TỔNG QUAN</span><h2>Hồ sơ cá nhân</h2></div>
    <div class="summary-grid">
        <article class="info-card">
            <span class="card-number">01</span>
            <h3>Kỹ năng</h3>
            <p>Các kỹ năng chuyên môn và kỹ năng mềm.</p>
            <a href="@Url.Action("KyNang", "PersonalPortfolio")">Xem chi tiết →</a>
        </article>
        <article class="info-card">
            <span class="card-number">02</span>
            <h3>Dự án</h3>
            <p>Các sản phẩm và dự án đã thực hiện.</p>
            <a href="@Url.Action("DuAn", "PersonalPortfolio")">Xem chi tiết →</a>
        </article>
        <article class="info-card">
            <span class="card-number">03</span>
            <h3>Kinh nghiệm</h3>
            <p>Quá trình học tập, làm việc và thực tập.</p>
            <a href="@Url.Action("KinhNghiem", "PersonalPortfolio")">Xem chi tiết →</a>
        </article>
    </div>
</section>

