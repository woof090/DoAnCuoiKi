@{
    ViewBag.Title = "Login";
    Layout = "~/Views/Shared/_LayoutTrangChu.cshtml";
    //Layout = "~/Views/Shared/_LayoutLogin.cshtml";
}
<link href="~/Content/MyStyleSheet/LayoutStyleSheet.css" rel="stylesheet" />
<script src="~/Scripts/MyScripts/LayoutJavaScript.js"></script>
<div class="login-container">
    <div class="login-box">
        <img src="~/Images/Logo/Login_01.jpg" alt="Logo" class="login-logo">
        <!-- ================= ĐĂNG NHẬP ================= -->
        <div id="loginForm">
            <div class="login-title">
                <h1>Đăng nhập</h1>
                <p>Chào mừng bạn quay trở lại!</p>
            </div>
            <form id="formLogin">
                <div class="form-group">
                    <input type="text"
                           id="username"
                           name="username"
                           placeholder="Tên đăng nhập"
                           required>
                    <span class="input-icon">
                        <img src="~/Images/Icon/Icon_Email.png" alt="icon">
                    </span>
                </div>
                <div class="form-group">
                    <input type="password"
                           id="password"
                           name="password"
                           placeholder="Mật khẩu"
                           required>
                    <span class="input-icon">
                        <img src="~/Images/Icon/Icon_Lock_Person.png" alt="icon">
                    </span>
                </div>
                <div class="forgot-password">
                    <a href="#">Quên mật khẩu?</a>
                </div>
                <button type="submit">
                    Đăng nhập ⇥
                </button>
            </form>
            <p class="register-link">
                Chưa có tài khoản?
                <a href="#" onclick="showRegister(); return false;">
                    Đăng ký
                </a>
            </p>
        </div>
        <!-- ================= ĐĂNG KÝ ================= -->
        <div id="registerForm" style="display: none;">
            <div class="login-title">
                <h1>Đăng ký tài khoản</h1>
                <p>Tạo tài khoản mới của bạn</p>
            </div>
            <form id="formRegister">
                <div class="form-group">
                    <input type="text"
                           name="fullname"
                           placeholder="Họ và tên"
                           maxlength="100"
                           required>
                </div>
                <div class="form-group">
                    <input type="text"
                           name="username"
                           placeholder="Tên đăng nhập"
                           minlength="4"
                           maxlength="20"
                           required>
                </div>
                <div class="form-group">
                    <input type="email"
                           id="email"
                           name="email"
                           placeholder="Email"
                           maxlength="254"
                           required>
                </div>
                <div class="form-group">
                    <input type="password"
                           id="regPassword"
                           name="password"
                           placeholder="Mật khẩu"
                           minlength="8"
                           required>
                </div>
                <!-- ĐIỀU KIỆN MẬT KHẨU -->
                <div class="password-rules" id="passwordRules" style="display: none;">
                    <p id="length">✗ Tối thiểu 8 ký tự</p>
                    <p id="uppercase">✗ Ít nhất 1 chữ in hoa (A-Z)</p>
                    <p id="lowercase">✗ Ít nhất 1 chữ thường (a-z)</p>
                    <p id="number">✗ Ít nhất 1 chữ số (0-9)</p>
                    <p id="special">✗ Ít nhất 1 ký tự đặc biệt (!#$...)</p>
                </div>
                <div class="form-group">
                    <input type="password"
                           id="confirmPassword"
                           name="confirmPassword"
                           placeholder="Nhập lại mật khẩu"
                           required>
                </div>
                <p id="passwordMessage"></p>
                <button type="submit">
                    Đăng ký ⇥
                </button>
            </form>
            <p class="register-link">
                Đã có tài khoản?
                <a href="#" onclick="showLogin(); return false;">
                    Đăng nhập
                </a>
            </p>
        </div>
        <!-- QUAY LẠI TRANG CHỦ -->
        <a href="@Url.Action("Index", "PersonalPortfolio")" class="home-link">
            ← Quay lại trang chủ
        </a>
    </div>
</div>
