
@{
    ViewBag.Title = "GioiThieu";
    Layout = "~/Views/Shared/_LayoutTrangChu.cshtml";
}
<link href="~/Content/MyStyleSheet/StyleSheetPortfolio.css" rel="stylesheet" />
<section class="page-heading">
    <span class="eyebrow">ABOUT ME</span>
    <h1>Giới thiệu bản thân</h1>
    <p>Thông tin tổng quan và định hướng phát triển cá nhân.</p>
</section>
<section class="about-card">
    <div class="avatar-placeholder avatar-small">
        ẢNH<br />CÁ NHÂN
    </div>
    <div class="about-content">
        <h2>Họ và tên</h2>
        <p class="muted">Sinh viên / Vị trí chuyên môn</p>
        <p>Viết phần giới thiệu bản thân, mục tiêu nghề nghiệp, sở thích và định hướng phát triển tại đây.</p>
        <div class="detail-grid">
            <div>
                <b>Ngày sinh</b>
                <span>DD/MM/YYYY</span>
            </div>
            <div>
                <b>Email</b>
                <span>email@example.com</span>
            </div>
            <div>
                <b>Điện thoại</b>
                <span>0123 456 789</span>
            </div>
            <div>
                <b>Địa chỉ</b>
                <span>Địa chỉ của bạn</span>
            </div>
        </div>
    </div>
</section>

