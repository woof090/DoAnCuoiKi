
@{
    ViewBag.Title = "KinhNghiem";
    Layout = "~/Views/Shared/_LayoutTrangChu.cshtml";
}
<link href="~/Content/MyStyleSheet/StyleSheetPortfolio.css" rel="stylesheet" />
<section class="page-heading">
    <span class="eyebrow">EXPERIENCE</span>
    <h1>Kinh nghiệm</h1>
    <p>Quá trình làm việc, thực tập và hoạt động chuyên môn.</p>
</section>
<section class="timeline">
    <article class="timeline-item">
        <span class="timeline-dot"></span>
        <div class="timeline-card">
            <span class="muted">2025 – Hiện tại</span>
            <h3>Vị trí công việc / Thực tập</h3>
            <h4>Tên công ty hoặc tổ chức</h4>
            <p>Mô tả công việc, nhiệm vụ đã thực hiện và thành tựu đạt được.</p>
        </div>
    </article>
    <article class="timeline-item">
        <span class="timeline-dot"></span>
        <div class="timeline-card">
            <span class="muted">2024 – 2025</span>
            <h3>Hoạt động / Dự án</h3>
            <h4>Tên đơn vị</h4>
            <p>Mô tả kinh nghiệm và kỹ năng tích lũy.</p>
        </div>
    </article>
</section>

