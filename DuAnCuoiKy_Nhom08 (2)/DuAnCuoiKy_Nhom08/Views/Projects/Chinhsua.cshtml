@model DuAnCuoiKy_Nhom08.Models.Project

@{
    ViewBag.Title = "Chinhsua";
    Layout = "~/Views/Shared/_LayoutTrangChu.cshtml";
}

<link href="~/Content/MyStyleSheet/StyleSheetPortfolio.css" rel="stylesheet" />
<link href="~/Content/MyStyleSheet/LayoutStyleSheet.css" rel="stylesheet" />
<section class="page-heading">
    <span class="eyebrow">EDIT PROJECT</span>
    <h1>Chỉnh sửa dự án</h1>
    <p>Cập nhật thông tin, danh mục, thẻ công nghệ và liên kết của dự án.</p>
</section>

<div class="about-card">
    @using (Html.BeginForm("Chinhsua", "Projects", FormMethod.Post))
    {
        @Html.AntiForgeryToken()
        @Html.ValidationSummary(true, "", new { @class = "text-danger" })
        @Html.HiddenFor(model => model.ProjectID)

        <div class="edit-grid">
            <div class="field-box">
                <label class="field-label" for="Title">Tên dự án</label>
                @Html.TextBoxFor(model => model.Title, new { @class = "input-custom", placeholder = "Nhập tên dự án" })
                @Html.ValidationMessageFor(model => model.Title, "", new { @class = "text-danger" })
            </div>

            <div class="field-box">
                <label class="field-label" for="CategoryID">Danh mục</label>
                @if (ViewBag.CategoryID != null)
                {
                    @Html.DropDownList("CategoryID", null, "-- Chọn danh mục --", new { @class = "input-custom" })
                }
                else
                {
                    @Html.TextBoxFor(model => model.CategoryID, new { @class = "input-custom", type = "number" })
                }
                @Html.ValidationMessageFor(model => model.CategoryID, "", new { @class = "text-danger" })
            </div>

            <div class="field-box field-full">
                <label class="field-label" for="Description">Mô tả dự án</label>
                @Html.TextAreaFor(model => model.Description, new { @class = "input-custom textarea-custom", placeholder = "Mô tả chi tiết dự án..." })
                @Html.ValidationMessageFor(model => model.Description, "", new { @class = "text-danger" })
            </div>

            <div class="field-box">
                <label class="field-label" for="Image">Đường dẫn hình ảnh</label>
                @Html.TextBoxFor(model => model.Image, new { @class = "input-custom", placeholder = "VD: /Content/Images/project1.png" })
                @Html.ValidationMessageFor(model => model.Image, "", new { @class = "text-danger" })
            </div>

            <div class="field-box">
                <label class="field-label" for="CreatedDate">Ngày tạo</label>
                @Html.TextBoxFor(model => model.CreatedDate, "{0:yyyy-MM-dd}", new { @class = "input-custom", type = "date" })
                @Html.ValidationMessageFor(model => model.CreatedDate, "", new { @class = "text-danger" })
            </div>

            <div class="field-box">
                <label class="field-label" for="ProjectURL">Link Demo / Website</label>
                @Html.TextBoxFor(model => model.ProjectURL, new { @class = "input-custom", placeholder = "https://..." })
                @Html.ValidationMessageFor(model => model.ProjectURL, "", new { @class = "text-danger" })
            </div>

            <div class="field-box">
                <label class="field-label" for="GithubURL">Link GitHub</label>
                @Html.TextBoxFor(model => model.GithubURL, new { @class = "input-custom", placeholder = "https://github.com/..." })
                @Html.ValidationMessageFor(model => model.GithubURL, "", new { @class = "text-danger" })
            </div>

            <div class="field-box">
                <label class="field-label" for="DisplayOrder">Thứ tự hiển thị</label>
                @Html.TextBoxFor(model => model.DisplayOrder, new { @class = "input-custom", type = "number" })
                @Html.ValidationMessageFor(model => model.DisplayOrder, "", new { @class = "text-danger" })
            </div>

            <div class="field-box">
                <label class="field-label">Trạng thái</label>
                <div class="status-inline">
                    @Html.CheckBox("Status", Model.Status == true)
                    <span>Hiển thị dự án</span>
                </div>
                @Html.ValidationMessageFor(model => model.Status, "", new { @class = "text-danger" })
            </div>

            @if (ViewBag.AllTags != null)
            {
                <div class="field-box field-full">
                    <label class="field-label">Công nghệ / Tags</label>
                    <div class="tag-checkbox-group">
                        @foreach (var tag in (IEnumerable<dynamic>)ViewBag.AllTags)
                        {
                            var isChecked = Model.Tags != null && Model.Tags.Any(t => t.TagID == tag.TagID);
                            <label class="tag-checkbox-item">
                                <input type="checkbox" name="selectedTags" value="@tag.TagID" @(isChecked ? "checked" : "") />
                                <span>@tag.TagName</span>
                            </label>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="form-actions">
            <button type="submit" class="btn-save">Lưu thay đổi</button>
            <a href="@Url.Action("Xemproject")" class="btn-back">← Quay lại danh sách</a>
        </div>
    }
</div>