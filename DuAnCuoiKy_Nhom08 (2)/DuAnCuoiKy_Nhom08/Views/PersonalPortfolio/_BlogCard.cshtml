@model DuAnCuoiKy_Nhom08.Models.BlogCardViewModel
@{
    var excerpt = (Model.Excerpt ?? "").Trim();
    if (excerpt.Length >= 220) { excerpt += "…"; }
    var detailUrl = Url.Action("BlogDetail", "PersonalPortfolio", new { id = Model.PostID });
}
<article class="blog-card">
    <a href="@detailUrl" class="blog-thumb-link">
        @if (!string.IsNullOrEmpty(Model.Thumbnail))
        {
            <img class="blog-thumb-img" src="@Url.Content(Model.Thumbnail)" alt="@Model.Title" />
        }
        else
        {
            <div class="blog-thumb">BLOG IMAGE</div>
        }
    </a>
    <div class="blog-body">
        <span class="muted">
            @(Model.CreatedDate.HasValue ? Model.CreatedDate.Value.ToString("dd/MM/yyyy") : "")
            @if (Model.IsFeatured)
            {
                <span class="badge badge-featured">★ Nổi bật</span>
            }
        </span>
        <h3><a href="@detailUrl">@Model.Title</a></h3>
        <p>@excerpt</p>
        <a href="@detailUrl">Đọc tiếp →</a>
    </div>
</article>
