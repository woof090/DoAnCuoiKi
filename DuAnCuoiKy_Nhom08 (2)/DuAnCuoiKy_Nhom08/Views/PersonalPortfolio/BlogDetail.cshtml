@model DuAnCuoiKy_Nhom08.Models.BlogPost
@{
    ViewBag.Title = Model.Title;
    Layout = "~/Views/Shared/_LayoutTrangChu.cshtml";
    var paragraphs = (Model.Content ?? "").Replace("\r\n", "\n")
        .Split(new[] { "\n\n" }, StringSplitOptions.RemoveEmptyEntries);
    var isDraft = ViewBag.IsDraft != null && (bool)ViewBag.IsDraft;
}
<link href="~/Content/MyStyleSheet/StyleSheetPortfolio.css" rel="stylesheet" />
<article class="blog-detail">
    <a class="back-link" href="@Url.Action("Blog", "PersonalPortfolio")">← Quay lại danh sách bài viết</a>

    @if (isDraft)
    {
        <div class="draft-notice">
            Bài viết này đang ở trạng thái <b>nháp (Draft)</b> – chỉ bạn (quản trị viên) nhìn thấy.
        </div>
    }

    <header class="blog-detail-head">
        <span class="muted">
            @(Model.CreatedDate.HasValue ? Model.CreatedDate.Value.ToString("dd/MM/yyyy") : "")
            @if (Model.UpdatedDate.HasValue && Model.CreatedDate.HasValue && Model.UpdatedDate.Value.Date != Model.CreatedDate.Value.Date)
            {
                <text>· Cập nhật @Model.UpdatedDate.Value.ToString("dd/MM/yyyy")</text>
            }
        </span>
        <h1>@Model.Title</h1>
        @if (Session["AdminID"] != null)
        {
            <a class="button-outline" href="@Url.Action("BlogEdit", "Admin", new { id = Model.PostID })">Sửa bài viết</a>
        }
    </header>

    @if (!string.IsNullOrEmpty(Model.Thumbnail))
    {
        <img class="blog-detail-img" src="@Url.Content(Model.Thumbnail)" alt="@Model.Title" />
    }

    <div class="blog-detail-content">
        @foreach (var para in paragraphs)
        {
            <p>@para</p>
        }
    </div>
</article>
