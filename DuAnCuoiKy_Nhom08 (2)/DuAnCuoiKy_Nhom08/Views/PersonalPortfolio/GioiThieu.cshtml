@model DuAnCuoiKy_Nhom08.Models.Profile
@{
    ViewBag.Title = "GioiThieu";
    Layout = "~/Views/Shared/_LayoutTrangChu.cshtml";
    var hasProfile = Model != null;
}
<link href="~/Content/MyStyleSheet/StyleSheetPortfolio.css" rel="stylesheet" />
<section class="page-heading">
    <span class="eyebrow">ABOUT ME</span>
    <h1>Giới thiệu bản thân</h1>
    <p>Thông tin tổng quan và định hướng phát triển cá nhân.</p>
</section>
<section class="about-card">
    @if (hasProfile && !string.IsNullOrEmpty(Model.Avatar))
    {
        <img class="avatar-img" src="@Url.Content(Model.Avatar)" alt="@Model.FullName" />
    }
    else
    {
        <div class="avatar-placeholder avatar-small">
            ẢNH<br />CÁ NHÂN
        </div>
    }
    <div class="about-content">
        @if (hasProfile)
        {
            <h2>@Model.FullName</h2>
            if (!string.IsNullOrEmpty(Model.Title))
            {
                <p class="muted">@Model.Title</p>
            }
            if (!string.IsNullOrEmpty(Model.Description))
            {
                <p class="about-description">@Model.Description</p>
            }
            <div class="detail-grid">
                @if (!string.IsNullOrEmpty(Model.Email))
                {
                    <div>
                        <b>Email</b>
                        <span>@Model.Email</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Phone))
                {
                    <div>
                        <b>Điện thoại</b>
                        <span>@Model.Phone</span>
                    </div>
                }
                @if (!string.IsNullOrEmpty(Model.Address))
                {
                    <div>
                        <b>Địa chỉ</b>
                        <span>@Model.Address</span>
                    </div>
                }
            </div>
        }
        else
        {
            <h2>Chưa có thông tin giới thiệu</h2>
            <p class="muted">Thông tin sẽ hiển thị tại đây sau khi chủ trang cập nhật.</p>
        }

        @if (Session["AdminID"] != null)
        {
            <p class="about-edit">
                <a class="button-outline" href="@Url.Action("Profile", "Admin")">Chỉnh sửa giới thiệu</a>
            </p>
        }
    </div>
</section>
