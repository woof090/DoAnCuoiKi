@model IEnumerable<DuAnCuoiKy_Nhom08.Models.Profile>

@{
    ViewBag.Title = "Xemprofile";
    Layout = "~/Views/Shared/_LayoutTrangChu.cshtml";
}
<link href="~/Content/MyStyleSheet/StyleSheetPortfolio.css?v=2" rel="stylesheet" />
<section class="page-heading">
    <span class="eyebrow">ABOUT ME</span>
    <h1>Giới thiệu bản thân</h1>
    <p>Thông tin tổng quan và định hướng phát triển cá nhân.</p>
</section>

<section class="about-card">
    @foreach (var item in Model)
    {
        <div class="profile-row">
            <div class="avatar-box">
                @if (!string.IsNullOrEmpty(item.Avatar))
                {
                    <img src="@Url.Content(item.Avatar)" alt="Ảnh cá nhân" />
                }
                else
                {
                    <div class="avatar-placeholder">
                        ẢNH<br />CÁ NHÂN
                    </div>
                }
            </div>

            <div class="profile-info">
                <h2>@Html.DisplayFor(modelItem => item.FullName)</h2>
                <h4>@Html.DisplayFor(modelItem => item.Title)</h4>
                <p>@Html.DisplayFor(modelItem => item.Description)</p>

                <div class="contact-grid">
                    <div class="contact-item">
                        <div class="contact-label">Email</div>
                        <div class="contact-value">@Html.DisplayFor(modelItem => item.Email)</div>
                    </div>

                    <div class="contact-item">
                        <div class="contact-label">Số điện thoại</div>
                        <div class="contact-value">@Html.DisplayFor(modelItem => item.Phone)</div>
                    </div>

                    <div class="contact-item">
                        <div class="contact-label">Địa chỉ</div>
                        <div class="contact-value">@Html.DisplayFor(modelItem => item.Address)</div>
                    </div>
                </div>

                <div style="margin-top: 16px">
                    @Html.ActionLink("Chỉnh sửa", "ChinhsuaProfile", new { id = item.ProfileID }, new { @class = "btn btn-primary btn-sm" })
                </div>
            </div>
        </div>
    }
</section>