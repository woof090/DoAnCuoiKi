@model DuAnCuoiKy_Nhom08.Models.ChangePasswordViewModel
@{
    ViewBag.Title = "Đổi mật khẩu";
    Layout = "~/Views/Shared/_LayoutTrangChu.cshtml";
}
<link href="~/Content/MyStyleSheet/StyleSheetPortfolio.css" rel="stylesheet" />
@Html.Partial("_AdminNav")

<section class="page-heading">
    <span class="eyebrow">TÀI KHOẢN</span>
    <h1>Đổi mật khẩu</h1>
    <p>Mật khẩu mới tối thiểu 8 ký tự, gồm chữ hoa, chữ thường, chữ số và ký tự đặc biệt.</p>
</section>

@using (Html.BeginForm("ChangePassword", "Admin", FormMethod.Post, new { @class = "admin-form admin-form-narrow" }))
{
    @Html.AntiForgeryToken()

    <div class="field">
        @Html.LabelFor(m => m.CurrentPassword)
        @Html.PasswordFor(m => m.CurrentPassword, new { autocomplete = "current-password" })
        @Html.ValidationMessageFor(m => m.CurrentPassword, "", new { @class = "field-error" })
    </div>
    <div class="field">
        @Html.LabelFor(m => m.NewPassword)
        @Html.PasswordFor(m => m.NewPassword, new { autocomplete = "new-password" })
        @Html.ValidationMessageFor(m => m.NewPassword, "", new { @class = "field-error" })
    </div>
    <div class="field">
        @Html.LabelFor(m => m.ConfirmPassword)
        @Html.PasswordFor(m => m.ConfirmPassword, new { autocomplete = "new-password" })
        @Html.ValidationMessageFor(m => m.ConfirmPassword, "", new { @class = "field-error" })
    </div>

    <div class="form-actions">
        <button type="submit" class="button-primary">Đổi mật khẩu</button>
    </div>
}
